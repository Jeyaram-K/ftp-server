<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_settings"
                android:contentDescription="@string/settings"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- Status Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            style="@style/CardStyle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center">

                <!-- Status Indicator -->
                <View
                    android:id="@+id/statusIndicator"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:background="@drawable/status_indicator"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/txtStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_stopped"
                    style="@style/StatusText"
                    android:layout_marginBottom="24dp" />

                <!-- Start/Stop Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartStop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/start_server"
                    style="@style/StartButton" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- URL Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            style="@style/CardStyle"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- FTP URL -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FTP (File Transfer)"
                    style="@style/LabelText"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/txtFtpUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ftp://192.168.1.100:2121"
                    style="@style/UrlText"
                    android:layout_marginBottom="16dp"
                    android:background="?attr/selectableItemBackground"
                    android:padding="8dp"
                    tools:text="ftp://192.168.1.100:2121" />

                <!-- WebDAV URL -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WebDAV (Open Files Directly)"
                    style="@style/LabelText"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/txtWebDavUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="http://192.168.1.100:8080"
                    style="@style/UrlText"
                    android:background="?attr/selectableItemBackground"
                    android:padding="8dp"
                    tools:text="http://192.168.1.100:8080" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tap_to_copy"
                    android:textSize="12sp"
                    android:textColor="@color/text_hint"
                    android:layout_marginTop="8dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- QR Code Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardQr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            style="@style/CardStyle"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/scan_qr_code"
                    style="@style/LabelText"
                    android:layout_marginBottom="16dp" />

                <ImageView
                    android:id="@+id/imgQrCode"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:background="@color/qr_background"
                    android:contentDescription="@string/scan_qr_code"
                    android:padding="8dp"
                    android:scaleType="fitCenter" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Storage Path Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStorage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            style="@style/CardStyle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/storage_path"
                    style="@style/LabelText"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/txtStoragePath"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="/storage/emulated/0"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:ellipsize="start"
                        android:singleLine="true"
                        tools:text="/storage/emulated/0" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSelectFolder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/select_folder"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:textSize="12sp" />

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Connection Log Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/CardStyle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/connection_log"
                    style="@style/LabelText"
                    android:layout_marginBottom="12dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="100dp"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_log" />

                <TextView
                    android:id="@+id/txtNoConnections"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/no_connections"
                    android:textSize="14sp"
                    android:textColor="@color/text_hint"
                    android:gravity="center"
                    android:padding="16dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
